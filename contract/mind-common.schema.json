{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kritva:mind:contract:common:0.1.0",
  "title": "Mind common definitions",
  "description": "PROPOSED (KOS-MIND-001, contract 0.1.0-draft). Shared definitions for the Mind request, context and result schemas. Timestamps are RFC 3339 date-time in UTC; durations carry their unit in the field name (_ms).",
  "$defs": {
    "ContractVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Digest": {
      "description": "Algorithm-prefixed digest, for example sha256:<64 hex characters>.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ContextRef": {
      "type": "object",
      "properties": {
        "context_id": { "$ref": "#/$defs/Id" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "required": ["context_id", "revision"],
      "additionalProperties": false
    },
    "Reference": {
      "description": "A reference to an immutable snapshot or to a source record held elsewhere.",
      "type": "object",
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/Digest" },
        "source_contract": {
          "description": "Name and version of the contract the referenced record follows (for a Sense observation, the versioned Sense contract).",
          "type": "string"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "Uncertainty": {
      "description": "A score alone is not uncertainty: the scale, source and calibration state are stated, and qualitative notes and assumptions are allowed.",
      "type": "object",
      "properties": {
        "score": { "type": "number" },
        "scale": {
          "description": "Meaning and range of the score, for example 'probability 0..1'.",
          "type": "string"
        },
        "source": { "type": "string" },
        "calibration": { "enum": ["CALIBRATED", "UNCALIBRATED", "UNKNOWN"] },
        "notes": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      },
      "dependentRequired": {
        "score": ["scale", "source", "calibration"]
      },
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["ERROR", "WARNING"] },
        "message": { "type": "string" },
        "detail": { "type": "object" }
      },
      "required": ["code", "severity", "message"],
      "additionalProperties": false
    },
    "Precondition": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "expression": { "type": "object" }
      },
      "required": ["description"],
      "additionalProperties": false
    },
    "ProposedSkill": {
      "description": "A recommendation to Skill. It is not an authorization: Skill resolves the reference, validates its manifest, version and preconditions, and decides.",
      "type": "object",
      "properties": {
        "skill_id": { "$ref": "#/$defs/Id" },
        "version_constraint": { "type": "string" },
        "parameters": { "type": "object" },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/Precondition" } },
        "rationale": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0 },
        "uncertainty": { "$ref": "#/$defs/Uncertainty" }
      },
      "required": ["skill_id", "parameters"],
      "additionalProperties": false
    },
    "ExecutionRecord": {
      "description": "Reasoning execution record: enough to reconstruct recorded conditions, verify input and output digests and classify replay fidelity. Only the replay class and the input are always required, so a request that failed or was cancelled before any inference ran can still be recorded without invented model or output data. A COMPLETED or PARTIAL result must carry the full record (see mind-result).",
      "type": "object",
      "properties": {
        "replay_class": {
          "enum": ["EXACT_REPLAY_SUPPORTED", "CONDITION_REPLAY_ONLY", "REPLAY_UNAVAILABLE"]
        },
        "input": { "$ref": "#/$defs/Reference" },
        "context_snapshot": { "$ref": "#/$defs/Reference" },
        "provider_id": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string" },
        "provider_config_digest": { "$ref": "#/$defs/Digest" },
        "prompt_template_digest": { "$ref": "#/$defs/Digest" },
        "inference_parameters": { "type": "object" },
        "random_seed": { "type": "integer" },
        "output": { "$ref": "#/$defs/Reference" },
        "executed_at": { "$ref": "#/$defs/Timestamp" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "tool_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["replay_class", "input"],
      "additionalProperties": false
    }
  }
}
